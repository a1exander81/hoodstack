// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LedgerEntryType {
  DEPOSIT
  WAGER
  PAYOUT
}

model LedgerEntry {
  id             String          @id @default(cuid())
  userId         String          // Privy DID (user.id) — NOT a wallet address
  type           LedgerEntryType
  amountMicroUsd BigInt          // integer minor units; positive = credit, negative = debit
  asset          String?         // "USDG" | "USDT" — deposits only; null for game rounds
  chainId        Int?            // 46630 | 97 — deposits only; null for game rounds
  txHash         String?         @unique // deposit idempotency key; null for game rounds
  gameRoundId    String?
  gameRound      GameRound?      @relation(fields: [gameRoundId], references: [id], onDelete: Restrict)
  crashBetId     String?         // Crash's two-phase bet, distinct from gameRoundId's single-shot rounds
  crashBet       CrashBet?       @relation(fields: [crashBetId], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now())

  @@index([userId])
  @@index([gameRoundId])
  @@index([crashBetId])
}

enum GameKind {
  COINFLIP
  CRASH
  MINES
  ROULETTE
}

/// Provably-fair seed pair. One server seed covers many rounds via an
/// incrementing nonce; see architecture.md invariant 2.
///
/// `revealedAt IS NULL` means active. There is deliberately no separate
/// `active` boolean -- a single field cannot contradict itself, and a
/// partial unique index enforces at most one active pair per user.
/// That index is NOT expressible in Prisma schema syntax and is added
/// as raw SQL in the migration; if it is ever dropped, two active pairs
/// can exist for one user and nonce ordering stops being meaningful.
model SeedPair {
  id             String      @id @default(cuid())
  userId         String      // Privy DID (user.id) — NOT a wallet address
  serverSeed     String      // SECRET until revealedAt is set — never send to a client before then
  serverSeedHash String      // SHA-256 of serverSeed; published at creation, before any bet
  clientSeed     String      // player-supplied or defaulted; editable only while this pair is active
  nonce          Int         @default(0) // last-used nonce; next round uses nonce + 1
  revealedAt     DateTime?   // set on rotation; non-null = closed, never accepts another round
  createdAt      DateTime    @default(now())
  rounds         GameRound[]

  @@index([userId])
}

/// A settled round. Outcome is reproducible from the pair's seeds plus
/// this nonce, so it is stored for display and dispute, never as the
/// source of truth for money -- that stays in LedgerEntry.
model GameRound {
  id             String   @id @default(cuid())
  userId         String   // Privy DID; denormalized from SeedPair for query speed
  seedPairId     String
  seedPair       SeedPair @relation(fields: [seedPairId], references: [id])
  nonce          Int
  game           GameKind
  outcome        Json     // game-specific: { side, result } for coinflip
  wagerMicroUsd  BigInt
  payoutMicroUsd BigInt   // 0 on a loss
  createdAt      DateTime @default(now())
  ledgerEntries  LedgerEntry[]

  // Load-bearing. Nonce reuse would silently reproduce an identical
  // outcome. Enforced at the DB level rather than by an app-side
  // increment, for the same reason services/ledger keys idempotency on
  // a unique txHash: an app-level check-then-insert has a race window
  // under concurrent requests that a constraint does not.
  @@unique([seedPairId, nonce])
  @@index([userId, createdAt])
}

enum CrashRoundStatus {
  BETTING
  RUNNING
  CRASHED
}

enum CrashBetStatus {
  PLACED
  CASHED_OUT
  LOST
}

/// A single round shared by many players -- one house-generated
/// commitment, one crash point -- not a SeedPair. See architecture.md
/// invariant 2's Crash addendum: a shared outcome cannot be a function
/// of any one player's client seed, so this uses per-round reveal (one
/// server seed per round, revealed once the round resolves) rather than
/// SeedPair's one-seed-many-rounds-via-nonce model. That tradeoff only
/// costs something for a game with a meaningful client seed; Crash's is
/// deliberately inert, so it costs nothing here.
model CrashRound {
  id                 String           @id @default(cuid())
  serverSeed         String           // SECRET until revealedAt is set
  serverSeedHash     String           // published to all clients before betting opens
  status             CrashRoundStatus @default(BETTING)
  crashMultiplierBps Int?             // set only once status = CRASHED; see services/games/crash.ts
  bettingClosedAt    DateTime?
  crashedAt          DateTime?
  revealedAt         DateTime?        // set once every bet against this round is resolved
  createdAt          DateTime         @default(now())
  bets               CrashBet[]

  @@index([status])
}

/// One player's bet against a shared CrashRound. Two-phase, unlike
/// GameRound: PLACED at bet time (the wager is already debited),
/// CASHED_OUT or LOST only once the round resolves -- see
/// services/ledger's placeCrashBet()/resolveCrashBet() (Milestone 2).
/// payoutMicroUsd is nullable specifically to distinguish "not yet
/// resolved" from "resolved as a loss" (0), a distinction GameRound
/// never needs because it is only ever written fully-formed.
model CrashBet {
  id                   String         @id @default(cuid())
  userId               String         // Privy DID
  crashRoundId         String
  crashRound           CrashRound     @relation(fields: [crashRoundId], references: [id])
  wagerMicroUsd        BigInt
  cashoutMultiplierBps Int?           // set only if the player cashed out before the crash
  status               CrashBetStatus @default(PLACED)
  payoutMicroUsd       BigInt?        // null until resolved; 0 on a loss
  createdAt            DateTime       @default(now())
  resolvedAt           DateTime?
  ledgerEntries        LedgerEntry[]

  // One bet per player per round -- mirrors GameRound's per-round
  // uniqueness and gives placeCrashBet() the same DB-level idempotency
  // shape as settleInstantRound() rather than an app-level check.
  @@unique([crashRoundId, userId])
  @@index([userId, createdAt])
}
