# Privy — create a free app at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# The public Robinhood Chain Testnet RPC (see src/lib/chains.ts) is shared
# and rate-limited. For anything beyond local dev, get a dedicated endpoint
# from Alchemy (recommended by Robinhood's own docs) and swap it into the
# transport config in src/providers/app-providers.tsx.
# ROBINHOOD_TESTNET_ALCHEMY_KEY=

# House treasury address that will receive x402/Permit2 deposits.
# Not used yet — this is wired up in the next unit (x402 deposit endpoint).
# HOUSE_TREASURY_ADDRESS=
